{
  // eslint.config.ts sits outside tsconfig.json's `src/` include, so `npm run build`
  // type-checks it here under the same strictness without emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "declaration": false, "sourceMap": false },
  "include": ["eslint.config.ts"]
}
