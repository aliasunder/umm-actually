node_modules/
dist/
# Fixture decoys carry real ignored-directory names so the related-files
# scan's pruning is tested against the genuine article — re-include them
!fixtures/workspace/node_modules/
!fixtures/workspace/dist/
.env
*.log
.DS_Store

# Symlinks into the private Obsidian vault (local dev only)
CLAUDE.local.md
TASKS.md

# .claude/ is local state except the committed session hooks. A trailing-slash
# directory ignore would block the re-includes, because git never descends
# into an ignored directory.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/install-deps.sh
